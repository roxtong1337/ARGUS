// REA rule pack: credential access, persistence and lateral movement.

rule Credential_Dumping_Tools
{
    meta:
        author      = "rea-team"
        severity    = "critical"
        score       = 45
        description = "References credential-dumping tooling or LSASS access"

    strings:
        $a = "sekurlsa::logonpasswords" nocase
        $b = "mimikatz" nocase
        $c = "lsass.exe" nocase
        $d = "procdump" nocase
        $e = "comsvcs.dll" nocase
        $f = "MiniDumpWriteDump"

    condition:
        any of them
}

rule SSH_Key_Harvesting
{
    meta:
        author      = "rea-team"
        severity    = "high"
        score       = 30
        description = "Reads private keys or shell history for exfiltration"

    strings:
        $a = ".ssh/id_rsa"
        $b = ".ssh/id_ed25519"
        $c = ".ssh/authorized_keys"
        $d = ".bash_history"
        $e = "/etc/shadow"
        $f = "known_hosts"

    condition:
        2 of them
}

rule Persistence_Registry_Run
{
    meta:
        author      = "rea-team"
        severity    = "medium"
        score       = 20
        description = "Registry Run-key persistence"

    strings:
        $a = "Software\\Microsoft\\Windows\\CurrentVersion\\Run" nocase
        $b = "Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce" nocase
        $c = "CurrentVersion\\Explorer\\Shell Folders" nocase
        $d = "schtasks /create" nocase

    condition:
        any of them
}

rule Lateral_Movement_SMB
{
    meta:
        author      = "rea-team"
        severity    = "high"
        score       = 30
        description = "Remote execution over SMB / WinRM / PsExec"

    strings:
        $a = "psexec" nocase
        $b = "\\\\admin$" nocase
        $c = "winrm" nocase
        $d = "net use \\\\" nocase
        $e = "wmic /node:" nocase
        $f = "Enter-PSSession" nocase

    condition:
        2 of them
}
